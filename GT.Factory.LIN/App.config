<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

  <appSettings>


    <!-- 默认LDF目录 -->
    <add key="LdfPath"
         value="Config"/>


    <!-- 当前模式 -->
    <!-- Mock / Hardware -->
    <add key="LinMode"
         value="Mock"/>


    <!-- 是否记录日志 -->
    <add key="EnableLog"
         value="true"/>


  </appSettings>
  
</configuration>